    shr.u32 %r25, %r20, 16; cvt.u16.u32 %h2, %r25; cvt.f32.f16 %f13, %h2;
    cvt.u16.u32 %h1, %r21; cvt.f32.f16 %f14, %h1;
    shr.u32 %r25, %r21, 16; cvt.u16.u32 %h2, %r25; cvt.f32.f16 %f15, %h2;
    cvt.u16.u32 %h1, %r22; cvt.f32.f16 %f16, %h1;
    shr.u32 %r25, %r22, 16; cvt.u16.u32 %h2, %r25; cvt.f32.f16 %f17, %h2;

    mul.f32 %f18, %f10, %f2;
    fma.rn.f32 %f18, %f11, %f3, %f18;
    fma.rn.f32 %f18, %f12, %f4, %f18;
    fma.rn.f32 %f18, %f13, %f5, %f18;
    fma.rn.f32 %f18, %f14, %f6, %f18;
    fma.rn.f32 %f18, %f15, %f7, %f18;
    fma.rn.f32 %f18, %f16, %f8, %f18;
    fma.rn.f32 %f18, %f17, %f9, %f18;
    add.f32 %f1, %f1, %f18;
    add.s32 %r17, %r17, 64;
    bra HF_QUAD;

HF_SCALAR:
    mov.u32 %r17, %r7;
HF_SLOOP:
