// ---------------------------------------------------------------------------
// Depthwise causal conv + SiLU in place over the qkv projection, with the
// rolling window in a persistent device buffer. One thread owns one channel
// across every time slice, so the rotation needs no barrier.
// grid = ceil(cd/256), block = 256
// ---------------------------------------------------------------------------
.visible .entry gdn_conv(
    .param .u64 arena,
    .param .u64 w,
    .param .u64 state,
    .param .u32 base,
    .param .u32 cd,
    .param .u32 kernel,
    .param .u32 hist
)
{
    .reg .pred %p<6>;
    .reg .b32 %r<24>;
    .reg .b64 %rd<24>;
    .reg .f32 %f<10>;

    ld.param.u64 %rd1, [arena];
    ld.param.u64 %rd2, [w];
    ld.param.u64 %rd3, [state];
    ld.param.u32 %r1, [base];
    ld.param.u32 %r2, [cd];
    ld.param.u32 %r3, [kernel];
    ld.param.u32 %r4, [hist];
    mov.u32 %r5, %ctaid.x;
    mov.u32 %r6, %tid.x;
    mad.lo.s32 %r7, %r5, 256, %r6;
    setp.ge.u32 %p1, %r7, %r2;
    @%p1 bra GC_DONE;

    add.s32 %r8, %r1, %r7;
    mul.wide.u32 %rd4, %r8, 4;
    add.s64 %rd5, %rd1, %rd4;
    ld.global.f32 %f1, [%rd5];

    mov.f32 %f2, 0f00000000;
    mov.u32 %r9, 0;
GC_HIST:
    setp.ge.u32 %p2, %r9, %r4;
    @%p2 bra GC_HIST_END;
    mad.lo.s32 %r10, %r9, %r2, %r7;
    mul.wide.u32 %rd6, %r10, 4;
    add.s64 %rd7, %rd3, %rd6;
    ld.global.f32 %f3, [%rd7];
    mad.lo.s32 %r11, %r7, %r3, %r9;
    mul.wide.u32 %rd8, %r11, 4;
    add.s64 %rd9, %rd2, %rd8;
    ld.global.f32 %f4, [%rd9];
    fma.rn.f32 %f2, %f3, %f4, %f2;
    add.s32 %r9, %r9, 1;
    bra GC_HIST;
GC_HIST_END:
    mad.lo.s32 %r12, %r7, %r3, %r4;
    mul.wide.u32 %rd10, %r12, 4;
    add.s64 %rd11, %rd2, %rd10;
    ld.global.f32 %f5, [%rd11];
    fma.rn.f32 %f2, %f1, %f5, %f2;

    mov.u32 %r13, 0;
GC_ROT:
    add.s32 %r14, %r13, 1;
    setp.ge.u32 %p3, %r14, %r4;
    @%p3 bra GC_ROT_END;
    mad.lo.s32 %r15, %r14, %r2, %r7;
    mul.wide.u32 %rd12, %r15, 4;
    add.s64 %rd13, %rd3, %rd12;
    ld.global.f32 %f6, [%rd13];
    mad.lo.s32 %r16, %r13, %r2, %r7;
    mul.wide.u32 %rd14, %r16, 4;
    add.s64 %rd15, %rd3, %rd14;
    st.global.f32 [%rd15], %f6;
    mov.u32 %r13, %r14;
    bra GC_ROT;
GC_ROT_END:
    setp.eq.u32 %p4, %r4, 0;
    @%p4 bra GC_SILU;
    sub.s32 %r17, %r4, 1;
    mad.lo.s32 %r18, %r17, %r2, %r7;
    mul.wide.u32 %rd16, %r18, 4;
    add.s64 %rd17, %rd3, %rd16;
    st.global.f32 [%rd17], %f1;
GC_SILU:
    neg.f32 %f7, %f2;
    mul.f32 %f7, %f7, 0f3FB8AA3B;
    ex2.approx.f32 %f7, %f7;
    add.f32 %f7, %f7, 0f3F800000;
    div.rn.f32 %f7, %f2, %f7;
    st.global.f32 [%rd5], %f7;
GC_DONE:
    ret;
}

// ---------------------------------------------------------------------------
// Gated delta net. One block per value head, 512 threads covering the head's
// [dk, dv] recurrence as G = 512/dv row groups of dv columns. The update is
// elementwise in (i, j); only the two reductions over i cross rows, and those
// go through shared memory. One thread per column left 24 SMs holding 32
// blocks and ran at memory latency instead of bandwidth.
// Shared: sq[256] sk[256] so[256] tmp[512].
// grid = nv, block = 512
// ---------------------------------------------------------------------------
.visible .entry gdn_rec(
    .param .u64 arena,
    .param .u64 w,
    .param .u64 state,
    .param .u32 base,
    .param .u32 out_off,
    .param .u32 kd,
    .param .u32 nv,
    .param .u32 dk,
    .param .u32 dv,
    .param .u32 rep,
    .param .f32 eps
)
{
    .shared .align 4 .b8 sh[5120];
    .reg .pred %p<8>;
    .reg .b32 %r<48>;
    .reg .b64 %rd<48>;
    .reg .f32 %f<32>;

    ld.param.u64 %rd1, [arena];
    ld.param.u64 %rd2, [w];
    ld.param.u64 %rd3, [state];
    ld.param.u32 %r1, [base];
    ld.param.u32 %r2, [out_off];
    ld.param.u32 %r3, [kd];
    ld.param.u32 %r4, [nv];
    ld.param.u32 %r5, [dk];
    ld.param.u32 %r6, [dv];
    ld.param.u32 %r7, [rep];
    ld.param.f32 %f1, [eps];

    mov.u32 %r8, %ctaid.x;
    mov.u32 %r9, %tid.x;
    mov.u64 %rd4, sh;
    add.s64 %rd13, %rd4, 3072;

    mul.lo.s32 %r10, %r4, %r6;
    shl.b32 %r11, %r3, 1;
    add.s32 %r12, %r11, %r10;
    div.u32 %r13, %r8, %r7;
    mad.lo.s32 %r14, %r13, %r5, %r1;
    add.s32 %r15, %r14, %r3;

    mov.u32 %r16, 512;
    div.u32 %r16, %r16, %r6;
    div.u32 %r17, %r9, %r6;
    mul.lo.s32 %r18, %r17, %r6;
    sub.s32 %r18, %r9, %r18;
    div.u32 %r19, %r5, %r16;
    mul.lo.s32 %r20, %r17, %r19;
    add.s32 %r21, %r20, %r19;

    mov.f32 %f2, 0f00000000;
    mov.f32 %f3, 0f00000000;
    mov.u32 %r22, %r9;
GR_LOAD:
    setp.ge.u32 %p1, %r22, %r5;
    @%p1 bra GR_LOAD_END;
    add.s32 %r23, %r14, %r22;
    mul.wide.u32 %rd5, %r23, 4;
    add.s64 %rd6, %rd1, %rd5;
    ld.global.f32 %f4, [%rd6];
    add.s32 %r23, %r15, %r22;
    mul.wide.u32 %rd7, %r23, 4;
    add.s64 %rd8, %rd1, %rd7;
    ld.global.f32 %f5, [%rd8];
    mul.wide.u32 %rd9, %r22, 4;
    add.s64 %rd10, %rd4, %rd9;
    st.shared.f32 [%rd10], %f4;
    add.s64 %rd11, %rd10, 1024;
    st.shared.f32 [%rd11], %f5;
    fma.rn.f32 %f2, %f4, %f4, %f2;
    fma.rn.f32 %f3, %f5, %f5, %f3;
    add.s32 %r22, %r22, 512;
    bra GR_LOAD;
GR_LOAD_END:
    mul.wide.u32 %rd12, %r9, 4;
    add.s64 %rd14, %rd13, %rd12;
    st.shared.f32 [%rd14], %f2;
    bar.sync 0;
    mov.u32 %r22, 256;
GR_TREE1:
    setp.ge.u32 %p2, %r9, %r22;
    @%p2 bra GR_SKIP1;
    add.s32 %r23, %r9, %r22;
    mul.wide.u32 %rd15, %r23, 4;
    add.s64 %rd16, %rd13, %rd15;
    ld.shared.f32 %f4, [%rd16];
    ld.shared.f32 %f5, [%rd14];
    add.f32 %f5, %f5, %f4;
    st.shared.f32 [%rd14], %f5;
GR_SKIP1:
    bar.sync 0;
    shr.u32 %r22, %r22, 1;
    setp.gt.u32 %p3, %r22, 0;
    @%p3 bra GR_TREE1;
    ld.shared.f32 %f6, [%rd13];
    add.f32 %f6, %f6, 0f358637BD;
    sqrt.rn.f32 %f6, %f6;
    div.rn.f32 %f7, 0f3F800000, %f6;
    bar.sync 0;

    st.shared.f32 [%rd14], %f3;
    bar.sync 0;
    mov.u32 %r22, 256;
GR_TREE2:
    setp.ge.u32 %p2, %r9, %r22;
    @%p2 bra GR_SKIP2;
    add.s32 %r23, %r9, %r22;
    mul.wide.u32 %rd15, %r23, 4;
    add.s64 %rd16, %rd13, %rd15;
    ld.shared.f32 %f4, [%rd16];
    ld.shared.f32 %f5, [%rd14];
    add.f32 %f5, %f5, %f4;
    st.shared.f32 [%rd14], %f5;
GR_SKIP2:
    bar.sync 0;
    shr.u32 %r22, %r22, 1;
    setp.gt.u32 %p3, %r22, 0;
    @%p3 bra GR_TREE2;
    ld.shared.f32 %f6, [%rd13];
    add.f32 %f6, %f6, 0f358637BD;
    sqrt.rn.f32 %f6, %f6;
    div.rn.f32 %f8, 0f3F800000, %f6;
    bar.sync 0;

    cvt.rn.f32.u32 %f6, %r5;
    sqrt.rn.f32 %f6, %f6;
    div.rn.f32 %f6, 0f3F800000, %f6;
    mov.u32 %r22, %r9;
GR_SCALE:
    setp.ge.u32 %p1, %r22, %r5;
    @%p1 bra GR_SCALE_END;
    mul.wide.u32 %rd9, %r22, 4;
    add.s64 %rd10, %rd4, %rd9;
    ld.shared.f32 %f4, [%rd10];
    mul.f32 %f4, %f4, %f7;
    mul.f32 %f4, %f4, %f6;
    st.shared.f32 [%rd10], %f4;
    add.s64 %rd11, %rd10, 1024;
    ld.shared.f32 %f5, [%rd11];
    mul.f32 %f5, %f5, %f8;
    st.shared.f32 [%rd11], %f5;
    add.s32 %r22, %r22, 512;
