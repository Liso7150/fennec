    @%p2 bra HF_RED;
    add.s32 %r18, %r13, %r17;
    mul.wide.u32 %rd3, %r18, 4;
    add.s64 %rd4, %rd1, %rd3;
    ld.global.nc.u32 %r19, [%rd4];
    shl.b32 %r23, %r17, 1;
    add.s32 %r24, %r3, %r23;
    mul.wide.u32 %rd5, %r24, 4;
    add.s64 %rd6, %rd2, %rd5;
    ld.global.f32 %f2, [%rd6];
