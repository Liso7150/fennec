// kv_prepare: grid = 2*n blocks, nkv*hd threads. Blocks below n rmsnorm (per
// KV head), rope and write the chunk's K rows into the device cache; blocks at
// or above n copy the raw V rows across. Rope pairs exchange the partner value
// through shared memory, so any rhalf width works.
.visible .entry kv_prepare(
    .param .u64 arena,
    .param .u64 norm,
    .param .u64 rope,
    .param .u64 kcache,
    .param .u64 vcache,
    .param .u32 sin_off,
    .param .u32 k_off,
    .param .u32 v_off,
    .param .u32 pos0,
    .param .u32 n,
    .param .u32 nkv,
    .param .u32 hd,
    .param .u32 rot,
    .param .f32 eps
) {
    .reg .pred %p<8>;
    .reg .b32 %r<48>;
    .reg .b64 %rd<40>;
    .reg .f32 %f<24>;
    .shared .align 4 .b8 sk[2048];

    ld.param.u64 %rd0, [arena];
    ld.param.u64 %rd1, [norm];
    ld.param.u64 %rd2, [rope];
    ld.param.u64 %rd3, [kcache];
    ld.param.u64 %rd4, [vcache];
    ld.param.u32 %r0, [sin_off];
    ld.param.u32 %r1, [k_off];
    ld.param.u32 %r2, [v_off];
    ld.param.u32 %r3, [pos0];
    ld.param.u32 %r4, [n];
    ld.param.u32 %r5, [nkv];
    ld.param.u32 %r6, [hd];
    ld.param.u32 %r7, [rot];
    ld.param.f32 %f0, [eps];

    mov.u32 %r8, %tid.x;
    mov.u32 %r9, %ctaid.x;
    mul.lo.u32 %r12, %r5, %r6;
    setp.ge.u32 %p0, %r9, %r4;
    @%p0 bra KP_VCOPY;

    div.u32 %r10, %r8, %r6;
    rem.u32 %r11, %r8, %r6;
    mad.lo.u32 %r13, %r9, %r12, %r1;
    mad.lo.u32 %r14, %r10, %r6, %r13;
    add.u32 %r14, %r14, %r11;
    mul.wide.u32 %rd5, %r14, 4;
    add.s64 %rd6, %rd0, %rd5;
    ld.global.f32 %f1, [%rd6];

    mul.f32 %f2, %f1, %f1;
    mul.wide.u32 %rd7, %r8, 4;
    mov.u64 %rd8, sk;
    add.s64 %rd9, %rd8, %rd7;
    st.shared.f32 [%rd9], %f2;
    bar.sync 0;
    shr.u32 %r15, %r6, 1;
KP_RED:
    setp.eq.u32 %p1, %r15, 0;
    @%p1 bra KP_NORM;
    setp.lt.u32 %p2, %r11, %r15;
    add.u32 %r16, %r8, %r15;
    mul.wide.u32 %rd10, %r16, 4;
    add.s64 %rd11, %rd8, %rd10;
    @%p2 ld.shared.f32 %f3, [%rd11];
    @%p2 add.f32 %f2, %f2, %f3;
    @%p2 st.shared.f32 [%rd9], %f2;
    bar.sync 0;
    shr.u32 %r15, %r15, 1;
    bra KP_RED;
KP_NORM:
    mad.lo.u32 %r17, %r10, %r6, 0;
    mul.wide.u32 %rd12, %r17, 4;
    add.s64 %rd13, %rd8, %rd12;
    ld.shared.f32 %f2, [%rd13];
    cvt.rn.f32.u32 %f4, %r6;
    div.rn.f32 %f5, %f2, %f4;
    add.f32 %f5, %f5, %f0;
    sqrt.rn.f32 %f6, %f5;
    div.rn.f32 %f7, 0f3F800000, %f6;
    add.u32 %r18, %r6, %r11;
    mul.wide.u32 %rd14, %r18, 4;
    add.s64 %rd15, %rd1, %rd14;
    ld.global.f32 %f8, [%rd15];
    mul.f32 %f9, %f1, %f7;
    mul.f32 %f9, %f9, %f8;
    st.shared.f32 [%rd9], %f9;
    bar.sync 0;
    shr.u32 %r19, %r7, 1;
    setp.lt.u32 %p3, %r11, %r19;
    setp.ge.u32 %p4, %r11, %r7;
    add.u32 %r20, %r3, %r9;
    mad.lo.u32 %r21, %r20, %r7, 0;
