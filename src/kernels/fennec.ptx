GR_SCALE_END:
    bar.sync 0;

    add.s32 %r24, %r12, %r10;
    add.s32 %r23, %r24, %r8;
    add.s32 %r23, %r23, %r1;
    mul.wide.u32 %rd17, %r23, 4;
    add.s64 %rd18, %rd1, %rd17;
    ld.global.f32 %f9, [%rd18];
    neg.f32 %f10, %f9;
    mul.f32 %f10, %f10, 0f3FB8AA3B;
    ex2.approx.f32 %f10, %f10;
    add.f32 %f10, %f10, 0f3F800000;
    div.rn.f32 %f9, 0f3F800000, %f10;

    add.s32 %r23, %r24, %r4;
    add.s32 %r23, %r23, %r8;
    add.s32 %r23, %r23, %r1;
    mul.wide.u32 %rd19, %r23, 4;
    add.s64 %rd20, %rd1, %rd19;
    ld.global.f32 %f10, [%rd20];
    add.s32 %r23, %r4, %r8;
    mul.wide.u32 %rd21, %r23, 4;
    add.s64 %rd22, %rd2, %rd21;
    ld.global.f32 %f11, [%rd22];
    add.f32 %f10, %f10, %f11;
    setp.gt.f32 %p4, %f10, 0f41A00000;
    @%p4 bra GR_SP_DONE;
    mul.f32 %f12, %f10, 0f3FB8AA3B;
    ex2.approx.f32 %f12, %f12;
    add.f32 %f12, %f12, 0f3F800000;
    lg2.approx.f32 %f12, %f12;
    mul.f32 %f12, %f12, 0f3F317218;
    mov.f32 %f10, %f12;
GR_SP_DONE:
    mul.wide.u32 %rd23, %r8, 4;
    add.s64 %rd24, %rd2, %rd23;
    ld.global.f32 %f12, [%rd24];
    mul.f32 %f13, %f12, 0f3FB8AA3B;
    ex2.approx.f32 %f13, %f13;
    mul.f32 %f13, %f13, %f10;
    neg.f32 %f13, %f13;
    mul.f32 %f14, %f13, 0f3FB8AA3B;
    ex2.approx.f32 %f14, %f14;

    mul.lo.s32 %r25, %r8, %r5;
    mul.lo.s32 %r25, %r25, %r6;
    mul.wide.u32 %rd29, %r6, 4;

    mad.lo.s32 %r23, %r8, %r6, %r18;
    add.s32 %r23, %r23, %r11;
    add.s32 %r23, %r23, %r1;
    mul.wide.u32 %rd25, %r23, 4;
    add.s64 %rd26, %rd1, %rd25;
    ld.global.f32 %f15, [%rd26];

    mad.lo.s32 %r23, %r20, %r6, %r18;
    add.s32 %r23, %r23, %r25;
    mul.wide.u32 %rd27, %r23, 4;
    add.s64 %rd28, %rd3, %rd27;

    mov.f32 %f16, 0f00000000;
    mov.u32 %r26, %r20;
    mov.u64 %rd30, %rd28;
// Four rows per iteration. One row at a time, the next load cannot issue until
// the previous store retires - ptxas cannot prove they do not alias - so the
// pass would run at memory latency instead of memory bandwidth.
GR_I1:
    setp.ge.u32 %p2, %r26, %r21;
    @%p2 bra GR_I1_END;
    ld.global.f32 %f21, [%rd30];
    add.s64 %rd31, %rd30, %rd29;
    ld.global.f32 %f22, [%rd31];
    add.s64 %rd32, %rd31, %rd29;
    ld.global.f32 %f23, [%rd32];
    add.s64 %rd33, %rd32, %rd29;
    ld.global.f32 %f24, [%rd33];
    mul.f32 %f21, %f21, %f14;
    mul.f32 %f22, %f22, %f14;
    mul.f32 %f23, %f23, %f14;
    mul.f32 %f24, %f24, %f14;
    st.global.f32 [%rd30], %f21;
    st.global.f32 [%rd31], %f22;
    st.global.f32 [%rd32], %f23;
    st.global.f32 [%rd33], %f24;
    mul.wide.u32 %rd34, %r26, 4;
    add.s64 %rd35, %rd4, 1024;
    add.s64 %rd35, %rd35, %rd34;
    ld.shared.f32 %f25, [%rd35];
    ld.shared.f32 %f26, [%rd35+4];
    ld.shared.f32 %f27, [%rd35+8];
    ld.shared.f32 %f28, [%rd35+12];
    fma.rn.f32 %f16, %f21, %f25, %f16;
    fma.rn.f32 %f16, %f22, %f26, %f16;
    fma.rn.f32 %f16, %f23, %f27, %f16;
    fma.rn.f32 %f16, %f24, %f28, %f16;
    add.s64 %rd30, %rd33, %rd29;
    add.s32 %r26, %r26, 4;
