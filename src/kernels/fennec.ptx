    mul.wide.u32 %rd31, %r18, 4;
    add.s64 %rd32, %rd4, 2048;
    add.s64 %rd32, %rd32, %rd31;
    ld.shared.f32 %f17, [%rd32];
    sub.f32 %f17, %f15, %f17;
    mul.f32 %f17, %f17, %f9;

    mov.f32 %f16, 0f00000000;
    mov.u32 %r26, %r20;
