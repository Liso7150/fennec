    fma.rn.f32 %f22, %f26, %f17, %f22;
    fma.rn.f32 %f23, %f27, %f17, %f23;
    fma.rn.f32 %f24, %f28, %f17, %f24;
    st.global.f32 [%rd30], %f21;
    st.global.f32 [%rd31], %f22;
    st.global.f32 [%rd32], %f23;
