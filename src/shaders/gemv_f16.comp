#version 450
// y = W x, W left as f16 pairs inside uints. The same four-rows-per-workgroup
// shape as gemv_bf16: 64 lanes per row, six reduction barriers paid once for
// four rows, 16 bytes per load. Only the unpack differs — f16 carries 10
// mantissa bits and a 5-bit exponent, so it needs a real conversion rather
// than bf16's shift into the top half of an f32.
layout(local_size_x = 256) in;
layout(push_constant) uniform P {
    uint rows;
    uint cols;
    uint x_off;
    uint y_off;
    uint row_base;
} p;
layout(set = 0, binding = 0) readonly buffer W { uint w[]; };
layout(set = 0, binding = 1) readonly buffer X { float x[]; };
layout(set = 0, binding = 2) writeonly buffer Y { float y[]; };
// The same weight buffer, viewed as 16-byte words. Binding it twice is what
// buys the wide load without a second copy of the weights in VRAM.
layout(set = 0, binding = 3) readonly buffer W4 { uvec4 w4[]; };
// The activation buffer again, viewed as vec4 so x is loaded four floats per
// instruction (the CUDA kernel's ld.global.v4.f32) instead of eight scalars.
layout(set = 0, binding = 4) readonly buffer X4 { vec4 x4[]; };

shared float red[256];

// f16 -> f32 uses the unpackHalf2x16 built-in (hardware cvt.f32.f16), inline in
// main. The old software conversion flushed subnormals on this driver when done
// as a single multiply; unpackHalf2x16 is the standard correct convert.

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint lane = tid & 63u;
    uint slot = tid >> 6;
    // row_base counts workgroups, not rows: the host splits a tall matrix into
    // dispatches of at most 65535 workgroups.
    uint r = (p.row_base + gl_WorkGroupID.x) * 4u + slot;
    uint half_cols = p.cols >> 1;
    float acc = 0.0;
    // No early return: every lane must reach the barriers below, including the
    // ones whose row is past the end of a partial last workgroup.
    if (r < p.rows) {
        uint base = r * half_cols;
        if ((half_cols & 3u) == 0u && (p.x_off & 3u) == 0u) {
            uint quads = half_cols >> 2;
            for (uint i = lane; i < quads; i += 64u) {
                uvec4 u = w4[(base >> 2) + i];
                uint c4 = (p.x_off >> 2) + (i << 1);
                vec4 x0 = x4[c4];
                vec4 x1 = x4[c4 + 1u];
                // unpackHalf2x16 is the hardware f16->f32 convert (the same
                // cvt.f32.f16 the CUDA kernel uses), one instruction per pair
                // and correct for subnormals — unlike the old software hf()
                // which spent ~7 integer ops plus findMSB on every weight.
                vec2 h0 = unpackHalf2x16(u.x);
                vec2 h1 = unpackHalf2x16(u.y);
                vec2 h2 = unpackHalf2x16(u.z);
                vec2 h3 = unpackHalf2x16(u.w);
                // Explicit terms, not dot(): dot is free to reduce in any order,
                // and matching gemv_bf16's order keeps the two shaders' error
                // against the CPU kernel the same size.
                acc += h0.x * x0.x + h0.y * x0.y + h1.x * x0.z + h1.y * x0.w
                     + h2.x * x1.x + h2.y * x1.y + h3.x * x1.z + h3.y * x1.w;
            }
        } else {
            // cols % 8 != 0, or x_off is not a whole vec4: `x_off >> 2` floors
            // without complaining, so either way the wide path reads the wrong
            // elements and only scalars answer the question that was asked.
            for (uint i = lane; i < half_cols; i += 64u) {
                uint u = w[base + i];
                uint c = p.x_off + (i << 1);
                vec2 h = unpackHalf2x16(u);
                acc += h.x * x[c] + h.y * x[c + 1u];
            }
        }
    }
    red[tid] = acc;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1) {
        if (lane < s) red[tid] += red[tid + s];
        barrier();
    }
    if (lane == 0u && r < p.rows) y[p.y_off + r] = red[tid];
}