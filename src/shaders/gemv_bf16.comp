#version 450
// y = W x, W left as bf16 pairs inside uints. Four rows per workgroup of 256:
// 64 lanes per row, so the six reduction barriers are paid once for four rows
// instead of once for one, and each lane pulls 16 bytes per load instead of 4.
// The lm_head's 248320 rows become 62080 workgroups, under the 65535 the spec
// guarantees, so it is a single dispatch.
layout(local_size_x = 256) in;
layout(push_constant) uniform P {
    uint rows;
    uint cols;
    uint x_off;
    uint y_off;
    uint row_base;
} p;
layout(set = 0, binding = 0) readonly buffer W { uint w[]; };
layout(set = 0, binding = 1) readonly buffer X { float x[]; };
layout(set = 0, binding = 2) writeonly buffer Y { float y[]; };
// The same weight buffer, viewed as 16-byte words. Binding it twice is what
// buys the wide load without a second copy of the weights in VRAM.
layout(set = 0, binding = 3) readonly buffer W4 { uvec4 w4[]; };
// The activation buffer again, viewed as vec4 for four-float loads.
layout(set = 0, binding = 4) readonly buffer X4 { vec4 x4[]; };

shared float red[256];

float bf(uint u, uint hi) {
    return uintBitsToFloat(((u >> (16u * hi)) & 0xFFFFu) << 16);
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint lane = tid & 63u;
    uint slot = tid >> 6;
    // row_base counts workgroups, not rows: the host splits a tall matrix into
    // dispatches of at most 65535 workgroups.
    uint r = (p.row_base + gl_WorkGroupID.x) * 4u + slot;
    uint half_cols = p.cols >> 1;
    float acc = 0.0;
    // No early return: every lane must reach the barriers below, including the
    // ones whose row is past the end of a partial last workgroup.
    if (r < p.rows) {
        uint base = r * half_cols;
        if ((half_cols & 3u) == 0u) {
            uint quads = half_cols >> 2;
            for (uint i = lane; i < quads; i += 64u) {
                uvec4 u = w4[(base >> 2) + i];
                uint c4 = (p.x_off >> 2) + (i << 1);
                vec4 x0 = x4[c4];
                vec4 x1 = x4[c4 + 1u];
                acc += bf(u.x, 0u) * x0.x + bf(u.x, 1u) * x0.y
                     + bf(u.y, 0u) * x0.z + bf(u.y, 1u) * x0.w
                     + bf(u.z, 0u) * x1.x + bf(u.z, 1u) * x1.y
                     + bf(u.w, 0u) * x1.z + bf(u.w, 1u) * x1.w;
            }
        } else {
            // cols % 8 != 0: a row base is not 16-byte aligned, so read scalars.
            for (uint i = lane; i < half_cols; i += 64u) {
                uint u = w[base + i];
                uint c = p.x_off + (i << 1);
                acc += bf(u, 0u) * x[c] + bf(u, 1u) * x[c + 1u];
            }
        }
    }
    red[tid] = acc;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1) {
        if (lane < s) red[tid] += red[tid + s];
        barrier();
    }
    if (lane == 0u && r < p.rows) y[p.y_off + r] = red[tid];
}